# --- SECURITY: КРИТИЧЕСКИЕ ДЫРЫ ---
# Удаляем скрипты, которые светят структуру папок и права доступа
/public/test_write.php
# Если Capacitor генерирует временный index.html в public, его тоже лучше скрыть
/public/index.html

# --- LARAVEL STORAGE ---
/storage/*.key
/storage/app/*
!/storage/app/public
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/pail
/storage/debugbar
/storage/logs/*
*.log

# --- EVIDENCE & REPORTS (Sentient Shield) ---
# Строго блокируем все скриншоты нарушителей
/storage/app/public/reports/*
!/storage/app/public/reports/.gitignore

# --- ANDROID & CAPACITOR (Твоего этого не было) ---
/android/.gradle
/android/app/build
/android/app/src/main/assets/public
/android/local.properties
/android/app/google-services.json
/android/app/src/main/res/raw/
*.keystore
*.jks
*.apk
*.aar

# --- OCTANE & BINARIES ---
.rr.yaml
# Если используешь Swoole/Roadrunner, скрываем их бинарники, если они скачаны в корень
rr

